# ---------------------------------------------------------------
# OmoAuto .gitignore
# ---------------------------------------------------------------

# Gradle / Kotlin
.gradle/
build/
.kotlin/
/build-logic/.gradle/
/build-logic/.kotlin/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
/local.properties
/captures/
.externalNativeBuild/
.cxx/
*.iml
.idea/
.navigation/
*.ipr
*.iws

# Build outputs (APK/AAB are published via GitHub Releases, not committed)
/dist/
*.apk
*.aab
*.ap_
*.dex
*.hprof
output-metadata.json

# Signing & secrets — never commit these
/keystore/
/keystore.properties
*.jks
*.keystore
google-services.json
.env
.env.*
*.secret

# Local helper state
/scripts/.wifi-device
/verify-build.bat
/build-log.txt
*.log

# Reverse-engineering material of the old app (kept locally only)
/_reference/

# Editors
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary folder from repo setup (move its contents into .github/, then delete it)
/_pindahkan-ke-.github/
